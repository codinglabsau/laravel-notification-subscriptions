{
  "name": "codinglabsau/laravel-notification-subscriptions",
  "description": "Manage user notification subscriptions across multiple notification types and channels",
  "keywords": [
    "Codinglabs",
    "laravel",
    "Notifications",
    "Notification Subscriptions",
    "laravel-notification-subscriptions"
  ],
  "homepage": "https://github.com/codinglabsau/laravel-notification-subscriptions",
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "illuminate/contracts": "^12.0|^13.0",
    "spatie/laravel-package-tools": "^1.9.2"
  },
  "require-dev": {
    "laravel/pint": "^1.25",
    "orchestra/testbench": "^10|^11",
    "pestphp/pest": "^3.0",
    "spatie/laravel-ray": "^1.26"
  },
  "autoload": {
    "psr-4": {
      "Codinglabs\\NotificationSubscriptions\\": "src",
      "Codinglabs\\NotificationSubscriptions\\Database\\Factories\\": "database/factories"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Codinglabs\\NotificationSubscriptions\\Tests\\": "tests"
    }
  },
  "scripts": {
    "test": "vendor/bin/pest"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Codinglabs\\NotificationSubscriptions\\NotificationSubscriptionsServiceProvider"
      ],
      "aliases": {
        "NotificationSubscriptions": "Codinglabs\\NotificationSubscriptions\\Facades\\NotificationSubscriptions"
      }
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
